# Copy to .env (or .env.local), then uncomment and fill the settings you use.
# Optional settings stay commented so this template cannot mask another env file.
# LLM_PRIMARY_PROVIDER=gemini
# LLM_FALLBACK_PROVIDERS=openrouter,openai

# GEMINI_API_KEY=
# Choose a text model available to your key. Model IDs are intentionally explicit.
# GEMINI_MODEL=

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional metadata sent to OpenRouter.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_SITE_NAME=Job Search OS
